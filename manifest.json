{
  "schemaVersion": 1,
  "id": "gumuller.tidal",
  "name": "TIDAL Controller",
  "version": "1.2.0",
  "author": "Gustavo Muller",
  "license": "MIT",
  "repository": "https://github.com/gumuller/omarchy-tidal",
  "description": "Control TIDAL Rust or TIDAL web with conservative automatic selection, an explicit browser picker, transport controls and native FFT spectrum.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "TIDAL",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "executable": "tidal-rs",
      "playerSource": "auto"
    },
    "schema": [
      {
        "key": "executable",
        "type": "string",
        "label": "TIDAL Rust executable"
      },
      {
        "key": "playerSource",
        "type": "string",
        "label": "Player source (auto, rust, or web session)"
      }
    ]
  }
}
